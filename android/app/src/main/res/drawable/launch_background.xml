<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen: the app's own background (#0A0D12) with the red mark
     centred, so the first frame a user sees is ZPlay rather than a white
     flash. The app is dark-only; see LaunchTheme in values/styles.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0A0D12" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
